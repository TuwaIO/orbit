{
  "name": "@tuwaio/orbit-solana",
  "version": "0.7.1",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L2 Solana package of Orbit Utils (TUWA): cached @solana/kit RPC clients, Wallet Standard discovery, cluster and explorer helpers, and SNS name and avatar lookups.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./signer": {
      "import": {
        "types": "./dist/signer.d.mts",
        "default": "./dist/signer.mjs"
      },
      "require": {
        "types": "./dist/signer.d.ts",
        "default": "./dist/signer.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run --typecheck"
  },
  "keywords": [
    "tuwa",
    "orbit",
    "web3",
    "solana",
    "@solana/kit",
    "wallet-standard",
    "sns",
    "typescript",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/orbit.git",
    "directory": "packages/orbit-solana"
  },
  "homepage": "https://github.com/TuwaIO/orbit",
  "bugs": {
    "url": "https://github.com/TuwaIO/orbit/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/orbit-core": ">=0.4",
    "@solana/kit": ">=6",
    "@wallet-standard/app": "1.x.x",
    "@wallet-standard/ui-core": "1.x.x",
    "@wallet-standard/ui-registry": "1.x.x"
  },
  "peerDependenciesMeta": {
    "@wallet-standard/app": {
      "optional": true
    },
    "@wallet-standard/ui-core": {
      "optional": true
    },
    "@wallet-standard/ui-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tuwaio/orbit-core": "workspace:^",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "@solana/kit": "^8.5.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/ui-core": "^1.0.1",
    "@wallet-standard/ui-registry": "^1.1.1"
  }
}
