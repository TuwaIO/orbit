    "typescript": "6.0.3",
    "@solana/kit": "^8.4.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/ui-core": "^1.0.1",
    "@wallet-standard/ui-registry": "^1.1.1"
  }
