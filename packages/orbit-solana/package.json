    "url": "https://github.com/TuwaIO/orbit/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/orbit-core": ">=0.4",
    "@solana/kit": ">=8.2",
    "@wallet-standard/app": "1.x.x",
    "@wallet-standard/ui-core": "1.x.x",
    "@wallet-standard/ui-registry": "1.x.x"
  },
  "devDependencies": {
    "@tuwaio/orbit-core": "workspace:^",
