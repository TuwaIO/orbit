  "license": "Apache-2.0",
  "description": "L2 EVM package of Orbit Utils (TUWA): cached viem clients, chain switching, ENS resolution and ERC-4337 smart accounts (Solady with a Pimlico bundler and paymaster), built on viem and @wagmi/core.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": [
    "tuwa",
    "orbit",
    "web3",
    "evm",
    "viem",
    "wagmi",
    "ens",
    "erc-4337",
    "account-abstraction",
    "pimlico",
    "solady",
    "typescript",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/orbit.git",
    "directory": "packages/orbit-evm"
  },
  "homepage": "https://github.com/TuwaIO/orbit",
  "bugs": {
    "url": "https://github.com/TuwaIO/orbit/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@wagmi/core": "3.x.x",
    "viem": "2.x.x"
  },
  "devDependencies": {
    "@wagmi/core": "^3.6.5",
