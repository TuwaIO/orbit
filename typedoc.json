{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Packages",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/*"],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/tests/**"],
    "excludeInternal": true,
    "gitRevision": "main"
  },
  "plugin": [
    "typedoc-plugin-markdown",
    "./apps/docs/typedoc/preserveTypeAnnotations.mjs",
    "./apps/docs/typedoc/nextraRoutes.mjs"
  ],
  "out": "apps/docs/src/content/packages",
  "publicPath": "/packages/",
  "readme": "apps/docs/typedoc/packages-overview.md",
  "mergeReadme": true,
  "entryFileName": "index",
  "excludeScopesInPaths": true,
  "pageTitleTemplates": {
    "member": "{name}"
  },
  "githubPages": false,
  "hideGenerator": true,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "cleanOutputDir": true
}
